# Copy to `.env` on the droplet (next to app.py) and fill in.
# systemd's EnvironmentFile= reads this file directly.

# --- Required ---
SECRET_KEY=replace_with_a_long_random_string

# --- Data source ---
# "file" = read snapshot pushed by the Misha-side pusher (default, recommended).
# "ssh"  = this Flask host SSHes into Misha directly (legacy / Yale-network host).
DATA_SOURCE=file

# Where the Misha pusher drops its snapshot. Must match the path in
# the droplet's /home/monitor/.ssh/authorized_keys command="..." line.
SNAPSHOT_FILE=/var/lib/monitor/snapshot.txt

# Alert threshold: dashboard shows "stale" if the snapshot is older
# than this many seconds. Pusher polls every 60s; 300s = 5 min.
SNAPSHOT_MAX_AGE=300

# --- Cosmetic / lab-specific ---
# Your SLURM account. Drives the "Lab Queue" panel. Leave empty to hide it.
LAB_ACCOUNT=

# Optional: comma-separated lab netids get highlighted in blue. Empty = no highlighting.
LAB_NETIDS=

# Email domain for "click a user to email" links.
EMAIL_DOMAIN=yale.edu

# Which partitions to display (must match what the pusher polls).
MISHA_PARTITIONS=gpu,gpu_devel

# --- Clusters ---
# Ordered list of clusters to serve. The first is the default, rendered at `/`
# and `/api/cluster`; each other one is served at `/<slug>` and
# `/api/cluster/<slug>`. Misha reads the legacy names above (SNAPSHOT_FILE,
# MISHA_PARTITIONS, LAB_ACCOUNT). Any other cluster reads <SLUG>_* variables.
CLUSTERS=misha

# Bouchet (uncomment these and set CLUSTERS=misha,bouchet). Its pusher key in
# the droplet's authorized_keys must be locked to
#   command="/usr/local/bin/monitor-receive.sh bouchet"
# which is what writes the snapshot file below. See DEPLOY_BOUCHET.md.
# BOUCHET_HOST=bouchet.ycrc.yale.edu
# BOUCHET_PARTITIONS=gpu,gpu_devel,gpu_h100,gpu_h200,gpu_b200,gpu_rtx6000
# BOUCHET_SNAPSHOT_FILE=/var/lib/monitor/bouchet/snapshot.txt
# BOUCHET_LAB_ACCOUNT=q_chen        # defaults to LAB_ACCOUNT
# BOUCHET_LABEL=Bouchet

# --- Bind ---
BIND=127.0.0.1
PORT=5111
USERS_FILE=/home/monitor/ClusterMonitor/users.json

# --- Only when DATA_SOURCE=ssh ---
# MISHA_HOST=misha.ycrc.yale.edu
# MISHA_USER=your_netid
